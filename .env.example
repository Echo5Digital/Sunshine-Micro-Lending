# ═══════════════════════════════════════════════════════
# SUNSHINE MICRO LENDING — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# REQUIRED = app will not work without this
# OPTIONAL = app works without it (feature disabled or default used)

# ─── DATABASE ─────────────────────────────────────────
# REQUIRED. Get from MongoDB Atlas → Connect → Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sunshine_lending?retryWrites=true&w=majority

# ─── EMAIL (Resend) ───────────────────────────────────
# REQUIRED for contact form emails. Get from resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The "from" address (must be on a verified Resend domain).
RESEND_FROM_EMAIL=noreply@sunshinemicrolending.com
# Where admin notification emails are sent.
RESEND_ADMIN_EMAIL=admin@sunshinemicrolending.com

# ─── COMPANY CONTACT ──────────────────────────────────
# OPTIONAL. Used in footer contact links. Defaults to hardcoded values if blank.
NEXT_PUBLIC_COMPANY_PHONE=18005867846
NEXT_PUBLIC_COMPANY_EMAIL=info@sunshinemicrolending.com

# ─── ANALYTICS ────────────────────────────────────────
# OPTIONAL. Leave blank to disable. No default in code.
# Get GA4 Measurement ID from Google Analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Get Project ID from clarity.microsoft.com.
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# ─── SEO ──────────────────────────────────────────────
# OPTIONAL. Only needed after Google Search Console verification.
# Get from Search Console → Settings → Ownership verification → HTML tag.
SEARCH_CONSOLE_VERIFICATION=
