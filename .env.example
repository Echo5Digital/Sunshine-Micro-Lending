# ═══════════════════════════════════════════════════════
# SUNSHINE MICRO LENDING - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ─── DATABASE (Neon PostgreSQL) ───────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/sunshine_lending?sslmode=require

# ─── SITE ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sunshinemicrolending.com

# ─── SANITY CMS ───────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token
SANITY_WEBHOOK_SECRET=your_sanity_webhook_secret

# ─── EMAIL (Resend) ───────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@sunshinemicrolending.com
RESEND_ADMIN_EMAIL=admin@sunshinemicrolending.com

# ─── ANALYTICS ────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=your_clarity_project_id

# ─── SEO ──────────────────────────────────────────────
SEARCH_CONSOLE_VERIFICATION=your_search_console_verification_code

# ─── COMPANY INFO (Public) ────────────────────────────
NEXT_PUBLIC_COMPANY_PHONE=+1-800-SUNSHINE
NEXT_PUBLIC_COMPANY_EMAIL=info@sunshinemicrolending.com
NEXT_PUBLIC_COMPANY_ADDRESS=Florida, United States

# ─── SECURITY ─────────────────────────────────────────
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60000

# ─── FEATURE FLAGS ────────────────────────────────────
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_APPLICATIONS_OPEN=true
