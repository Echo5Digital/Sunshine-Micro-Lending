# ═══════════════════════════════════════════════════════
# SUNSHINE MICRO LENDING — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# REQUIRED = app will not work without this
# OPTIONAL = app works without it (feature disabled or default used)

# ─── DATABASE ─────────────────────────────────────────
# REQUIRED. Get from MongoDB Atlas → Connect → Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sunshine_lending?retryWrites=true&w=majority

# ─── EMAIL (Resend) ───────────────────────────────────
# REQUIRED for contact form emails. Get from resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The "from" address (must be on a verified Resend domain).
RESEND_FROM_EMAIL=noreply@sunshinemicrolending.com
# Where admin notification emails are sent.
RESEND_ADMIN_EMAIL=admin@sunshinemicrolending.com

# ─── COMPANY CONTACT ──────────────────────────────────
# OPTIONAL. Used in footer contact links. Defaults to hardcoded values if blank.
NEXT_PUBLIC_COMPANY_PHONE=18005867846
NEXT_PUBLIC_COMPANY_EMAIL=info@sunshinemicrolending.com

# ─── ANALYTICS ────────────────────────────────────────
# OPTIONAL. Leave blank to disable. No default in code.
# Get GA4 Measurement ID from Google Analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Get Project ID from clarity.microsoft.com.
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# ─── SEO ──────────────────────────────────────────────
# OPTIONAL. Only needed after Google Search Console verification.
# Get from Search Console → Settings → Ownership verification → HTML tag.
SEARCH_CONSOLE_VERIFICATION=

# ─── DOCUMENT UPLOAD (Cloudinary) ──────────────────────
# REQUIRED for the application form's document upload (pay stub / bank statement).
# Get from cloudinary.com → Console → Dashboard → API Keys.
# IMPORTANT: also enable "Allow delivery of PDF and ZIP files" under
# Console → Settings → Security, or PDF documents will fail to load for admins.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── FEATURE FLAGS ─────────────────────────────────────
# OPTIONAL. Defaults to "true" (shows "launching soon" messaging) if unset.
# Set to "false" once the lender is licensed and live to switch confirmation
# messaging to normal "application processing" copy without a redeploy.
NEXT_PUBLIC_LAUNCHING_SOON=true

# ─── ADMIN PANEL AUTH ──────────────────────────────────
# REQUIRED for the internal admin panel (/admin). Signs/verifies staff
# session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this value logs out all staff sessions.
SESSION_SECRET=
